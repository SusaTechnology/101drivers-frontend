# ── Server ──
PORT=6000
NODE_ENV=production

# ── Auth ──
JWT_SECRET_KEY=your-jwt-secret
JWT_EXPIRATION=7d

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/101drivers

# ── Stripe (Payment Processing) ──
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# Set your webhook endpoint secret from Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ── Postpaid Billing (dealer weekly metered anchor subscription) ──
# Create a Price on Stripe dashboard:
#   • type: recurring
#   • interval: week, interval_count: 1
#   • unit_amount: 0 (anchor must be $0; per-delivery amounts are added
#     as ad-hoc InvoiceItems at delivery completion)
#   • usage_type: licensed (metered NOT required — engine uses
#     stripe.invoiceItems.create, not createUsageRecord)
# Then paste the price id (price_xxx) here.
STRIPE_POSTPAID_PRICE_ID=price_xxx

# ── Email ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@101drivers.com

# ── Domain ──
101_DOMAIN=https://101drivers.com

# ── GraphQL ──
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false
