# ── Server ──
PORT=6000
NODE_ENV=production

# ── Auth ──
JWT_SECRET_KEY=your-jwt-secret
JWT_EXPIRATION=7d

# ── Database ──
DATABASE_URL=postgresql://user:password@localhost:5432/101drivers

# ── Stripe (Payment Processing) ──
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxx
# Set your webhook endpoint secret from Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ── Postpaid Billing (dealer weekly metered anchor subscription) ──
# Create a Price on Stripe dashboard:
#   • type: recurring
#   • interval: week, interval_count: 1
#   • unit_amount: 0 (anchor must be $0; per-delivery amounts are added
#     as ad-hoc InvoiceItems at delivery completion)
#   • usage_type: licensed (metered NOT required — engine uses
#     stripe.invoiceItems.create, not createUsageRecord)
# Then paste the price id (price_xxx) here.
STRIPE_POSTPAID_PRICE_ID=price_xxx

# ── Email ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
# Sender shown on every email (verification codes, invites, approvals,
# delivery + tracking updates). Keep the display-name format.
# NOTE (Gmail SMTP): the address must be the authenticated Gmail account or a
# verified "Send mail as" alias on it, otherwise Gmail rewrites the From.
SMTP_FROM="101 Drivers <noreply@101drivers.com>"

# ── Domain ──
101_DOMAIN=https://101drivers.com

# ── Better Auth (drivers identity — see docs/auth/better-auth-drivers.md) ──
# Session signing secret. STRONGLY recommended: a dedicated 32+ char secret.
# Falls back to JWT_ACCESS_SECRET ?? JWT_SECRET when unset (so a deploy
# without this variable still boots).
BETTER_AUTH_SECRET=
# Explicit API base URL of the mounted handler (recommended in production
# behind proxies). Example: https://api.101drivers.com/api/better-auth
# When unset, Better Auth infers it from request headers.
BETTER_AUTH_URL=
# Frontend origin used in verification / password-reset email links.
# Defaults to 101_DOMAIN when unset.
BETTER_AUTH_FRONTEND_ORIGIN=
# Extra trusted origins (comma-separated) on top of the built-in allowlist
# (101drivers.com, www, techbee.et, appleid.apple.com).
BETTER_AUTH_TRUSTED_ORIGINS=

# ── Better Auth social providers (each is OPTIONAL — unset = disabled) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# MICROSOFT_TENANT_ID defaults to "common" (personal + any organization).
# Set "organizations" / "consumers" / a tenant GUID to narrow deliberately.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=

# Apple: EITHER the three key fields (runtime ES256 client-secret generation
# — recommended, nothing expires silently) OR a pre-generated APPLE_CLIENT_SECRET
# JWT (must be rotated before its ≤180-day expiry).
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=
APPLE_KEY_ID=
APPLE_TEAM_ID=
APPLE_CLIENT_SECRET=

# Yahoo — Generic OAuth (OIDC discovery at api.login.yahoo.com).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# ── GraphQL ──
GRAPHQL_PLAYGROUND=false
GRAPHQL_INTROSPECTION=false
